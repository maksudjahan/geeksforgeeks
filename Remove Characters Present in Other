class Solution {
  public:
    string removeChars(string &s1, string &s2) {
        // code here
        int j,i;
        string s3="";
        for(i=s1.size()-1;i>=0;i--){
            for(j=s2.size()-1;j>=0;j--){
                if(s1[i]==s2[j]) {
                    s1.erase(i,1);
                    break;
                    
                }
            }
        }
        return s1;
    }
};
